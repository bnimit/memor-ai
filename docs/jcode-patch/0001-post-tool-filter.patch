+/// because the replacement is longer than the secret. A generous multiple still
+/// bounds a runaway hook, which is the only thing worth preventing here.
+const POST_TOOL_GROWTH_LIMIT: usize = 2;
+/// Absolute slack for tiny payloads, where a multiple is too tight to be useful.
+const POST_TOOL_GROWTH_FLOOR: usize = 4096;
