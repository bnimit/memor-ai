+/// Run the `post_tool` hook as a *filter*, letting it rewrite the tool output.
+///
+/// Only active when `hooks.post_tool_filter` is set. `post_tool` is otherwise a
+/// detached observer that can never slow a turn, and that property is worth
+/// keeping by default; a user who wants to compress or redact tool output has
+/// to ask for the synchronous behaviour explicitly.
+///
+/// The hook receives the same env as the observer form plus the tool output on
+/// stdin. Contract, deliberately the same shape as the `pre_tool` gate:
+///
+/// - exit 0 with non-empty stdout: stdout replaces the tool output
+/// - exit 0 with empty stdout: output unchanged ("no opinion")
+/// - anything else (non-zero exit, timeout, spawn failure): output unchanged
+///
+/// Every failure path keeps the original output. A filter that crashes must
+/// cost the user a compression, never a tool result.
+pub async fn run_post_tool_filter(
+    session_id: &str,
+    working_dir: Option<&str>,
+    tool_name: &str,
+    output: &str,
+) -> Option<String> {
+    if !crate::config::config().hooks.post_tool_filter {
+        return None;
+    }
+    let command_lines = hook_commands("post_tool");
+    if command_lines.is_empty() {
+        return None;
+    }
+
+    let mut event = HookEvent::new("post_tool")
+        .session_id(session_id)
+        .field("TOOL_NAME", tool_name)
+        .field("MODE", "filter")
+        .field("OUTPUT_BYTES", output.len().to_string());
+    if let Some(cwd) = working_dir {
+        event = event.cwd(cwd);
+    }
+
+    // Hooks chain: each sees the previous one's result, so two filters compose
+    // instead of racing to replace the same original.
+    let mut current: Option<String> = None;
+    for command_line in command_lines {
+        let input = current.as_deref().unwrap_or(output);
+        if let Some(filtered) = run_post_tool_filter_command(&command_line, &event, input).await {
+            current = Some(filtered);
+        }
+    }
+    current
+}
+
+async fn run_post_tool_filter_command(
+    command_line: &str,
+    event: &HookEvent,
+    output: &str,
+) -> Option<String> {
+    let std_cmd = match build_hook_process(command_line, event) {
+        Ok(cmd) => cmd,
+        Err(error) => {
+            crate::logging::warn(&format!(
+                "Hook 'post_tool' command '{command_line}' is invalid: {error} (keeping original output)"
+            ));
+            return None;
+        }
+    };
+
+    let mut cmd = tokio::process::Command::from(std_cmd);
+    cmd.stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::null())
+        .kill_on_drop(true);
+
+    let mut child = match cmd.spawn() {
+        Ok(child) => child,
+        Err(error) => {
+            crate::logging::warn(&format!(
+                "Hook 'post_tool' command '{command_line}' failed to start: {error} (keeping original output)"
+            ));
+            return None;
+        }
+    };
+
+    if let Some(mut stdin) = child.stdin.take() {
+        use tokio::io::AsyncWriteExt;
+        // A filter that exits before reading everything (head-style) closes the
+        // pipe; that is an EPIPE, not an error worth discarding its result for.
+        let _ = stdin.write_all(output.as_bytes()).await;
+        drop(stdin);
+    }
+
+    let timeout =
+        std::time::Duration::from_millis(crate::config::config().hooks.post_tool_timeout_ms.max(1));
+    let result = match tokio::time::timeout(timeout, child.wait_with_output()).await {
+        Ok(Ok(result)) => result,
+        Ok(Err(error)) => {
+            crate::logging::warn(&format!(
+                "Hook 'post_tool' command '{command_line}' failed: {error} (keeping original output)"
+            ));
+            return None;
+        }
+        Err(_elapsed) => {
+            crate::logging::warn(&format!(
+                "Hook 'post_tool' command '{command_line}' timed out after {}ms (keeping original output)",
+                timeout.as_millis()
+            ));
+            return None;
+        }
+    };
+
+    if result.status.code() != Some(0) {
+        crate::logging::warn(&format!(
+            "Hook 'post_tool' command '{command_line}' exited with {:?} (keeping original output)",
+            result.status.code()
+        ));
+        return None;
+    }
+
+    // Invalid UTF-8 means the filter is not producing text the model can read.
+    let filtered = match String::from_utf8(result.stdout) {
+        Ok(text) => text,
+        Err(_) => {
+            crate::logging::warn(&format!(
+                "Hook 'post_tool' command '{command_line}' returned invalid UTF-8 (keeping original output)"
+            ));
+            return None;
+        }
+    };
+    if filtered.trim().is_empty() {
+        return None;
+    }
+    // A filter must not be able to inflate context without limit, but it is not
+    // only a compressor: redaction legitimately grows its input, because
+    // "[redacted]" is longer than the secret it replaces. So the ceiling is a
+    // slack multiple rather than the input size, which stops a runaway hook
+    // while leaving room for a substitution that expands.
+    let ceiling = output
+        .len()
+        .saturating_mul(POST_TOOL_GROWTH_LIMIT)
+        .max(POST_TOOL_GROWTH_FLOOR);
+    if filtered.len() > ceiling {
+        crate::logging::warn(&format!(
+            "Hook 'post_tool' command '{command_line}' returned far more than it was given ({} -> {} bytes, ceiling {ceiling}; keeping original output)",
+            output.len(),
+            filtered.len()
+        ));
+        return None;
+    }
+    Some(filtered)
+}
