+    /// Build a throwaway filter script and return its path.
+    fn filter_script(body: &str) -> std::path::PathBuf {
+        use std::io::Write;
+        let dir = std::env::temp_dir().join(format!(
+            "jcode-filter-test-{}",
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("filter.sh");
+        let mut f = std::fs::File::create(&path).unwrap();
+        writeln!(f, "#!/bin/sh\n{body}").unwrap();
+        drop(f);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).unwrap();
+        }
+        path
+    }
+
+    #[test]
+    fn post_tool_filter_is_off_unless_enabled() {
+        // The observer property is the default and must stay that way: a hook
+        // that cannot slow a turn is why post_tool is safe to configure.
+        let cfg = jcode_config_types::HooksConfig::default();
+        assert!(!cfg.post_tool_filter);
+        assert_eq!(cfg.post_tool_timeout_ms, 5000);
+    }
+
+    #[tokio::test]
+    async fn post_tool_filter_rewrites_output_when_enabled() {
+        let script = filter_script("sed 's/SECRET/[redacted]/g'");
+        let event = HookEvent::new("post_tool").session_id("s1");
+        let out = run_post_tool_filter_command(
+            script.to_str().unwrap(),
+            &event,
+            "before SECRET after SECRET tail",
+        )
+        .await;
+        assert_eq!(
+            out.as_deref(),
+            Some("before [redacted] after [redacted] tail")
+        );
+
+        // ...and the compression case it was actually built for.
+        let crush = filter_script("head -c 40");
+        let long = "noise ".repeat(200);
+        let crushed = run_post_tool_filter_command(crush.to_str().unwrap(), &event, &long).await;
+        assert!(crushed.is_some_and(|t| t.len() < long.len()));
+    }
+
+    #[tokio::test]
+    async fn post_tool_filter_keeps_original_on_failure() {
+        let event = HookEvent::new("post_tool").session_id("s1");
+        let payload = "the original output that must survive";
+
+        // Non-zero exit: the filter is broken, not the output.
+        let failing = filter_script("cat >/dev/null; exit 3");
+        assert!(
+            run_post_tool_filter_command(failing.to_str().unwrap(), &event, payload)
+                .await
+                .is_none()
+        );
+
+        // Empty stdout means "no opinion", not "delete everything".
+        let silent = filter_script("cat >/dev/null; exit 0");
+        assert!(
+            run_post_tool_filter_command(silent.to_str().unwrap(), &event, payload)
+                .await
+                .is_none()
+        );
+
+        // A command that does not exist must not cost a tool result.
+        assert!(
+            run_post_tool_filter_command(
+                "/nonexistent/jcode-filter-does-not-exist",
+                &event,
+                payload
+            )
+            .await
+            .is_none()
+        );
+    }
+
+    #[tokio::test]
+    async fn post_tool_filter_allows_redaction_that_grows_a_little() {
+        // A filter is not only a compressor: "[redacted]" is longer than the
+        // secret it replaces, so a strict "must not grow" rule would reject the
+        // single most obvious use for this hook.
+        let script = filter_script("sed 's/SECRET/[redacted]/g'");
+        let event = HookEvent::new("post_tool").session_id("s1");
+        let out =
+            run_post_tool_filter_command(script.to_str().unwrap(), &event, "a SECRET b SECRET c")
+                .await;
+        assert_eq!(out.as_deref(), Some("a [redacted] b [redacted] c"));
+    }
+
+    #[tokio::test]
+    async fn post_tool_filter_refuses_runaway_growth() {
+        // Bounded, though: a hook must not be able to inflate context freely.
+        let script = filter_script("cat >/dev/null; head -c 200000 /dev/zero | tr '\\0' 'x'");
+        let event = HookEvent::new("post_tool").session_id("s1");
+        let payload = "x".repeat(5000);
+        assert!(
+            run_post_tool_filter_command(script.to_str().unwrap(), &event, &payload)
+                .await
+                .is_none()
+        );
+    }
+
